{
  "name": "pi-usage-plus",
  "version": "0.2.0",
  "description": "Super usage/quota extension for Pi & Pi Web – 10+ providers, Kimi/Moonshot, OpenRouter, OpenCode Go, DeepSeek, GLM, dual Pi & Pi Web compatible",
  "type": "module",
  "license": "MIT",
  "author": "VinceJan <2086759341@qq.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/VinceJan/pi-usage-plus"
  },
  "homepage": "https://github.com/VinceJan/pi-usage-plus#readme",
  "bugs": {
    "url": "https://github.com/VinceJan/pi-usage-plus/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "usage",
    "quota",
    "balance",
    "openrouter",
    "opencode-go",
    "kimi",
    "moonshot",
    "deepseek",
    "cliproxyapi",
    "pi-web"
  ],
  "files": [
    "index.ts",
    "src",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@earendil-works/pi-tui": "0.84.4",
    "@types/node": "^24.10.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --import tsx --test test/**/*.test.ts",
    "verify": "npm run check && npm test",
    "pack:check": "npm pack --dry-run"
  }
}
